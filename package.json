{
  "bin": {
    "tldw": "./bin/tldw.mjs"
  },
  "bugs": {
    "url": "https://github.com/tldwdotsh/tldw-js/issues"
  },
  "description": "Dependency-free tldw.sh async analysis client and agent setup tools",
  "engines": {
    "node": ">=20.11.0"
  },
  "exports": {
    ".": {
      "import": "./src/index.mjs",
      "types": "./src/index.d.ts"
    }
  },
  "files": [
    "src",
    "bin",
    "plugin",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://tldw.sh/agents",
  "keywords": [
    "tldw",
    "video",
    "analysis",
    "agents",
    "mcp",
    "async",
    "api"
  ],
  "license": "MIT",
  "name": "@tldw/client",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tldwdotsh/tldw-js.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "type": "module",
  "types": "./src/index.d.ts",
  "version": "0.2.15"
}
